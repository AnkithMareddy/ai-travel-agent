# Copy this file to .env for running on your own computer (npm run dev).
# On Railway, add these as Variables instead. Never commit the real .env.

# Required: from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Recommended: from console.anthropic.com (without it, messages use plain templates)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Optional: your numeric Telegram user id (from @userinfobot). If set, only you can claim the bot with /start.
OWNER_USER_ID=

# Optional: TfL Journey Planner key from api-portal.tfl.gov.uk (works without one, just rate-limited)
TFL_APP_KEY=

# Where the bot keeps its memory (who's allowed, alerts sent, suggestions given). On Railway use /data with a volume.
DATA_DIR=./state

# Public web address of the server, for the /map page. Railway fills this in automatically.
PUBLIC_URL=

# Optional: group chat ids to approve at startup (comma-separated), e.g. when moving to a new server.
APPROVED_GROUP_IDS=

# Optional: Splitwise, so receipts and "I paid 45 for petrol" go straight into your shared group.
# Get a personal API key: https://secure.splitwise.com/apps → Register your application → "API key".
SPLITWISE_API_KEY=
# The trip's Splitwise group id (or leave empty and send /splitwise in the chat to pick it).
SPLITWISE_GROUP_ID=

# Optional: live traffic for road-trip drive times and leave-by alerts. Set ONE of these.
# Google: console.cloud.google.com → enable "Routes API" → Credentials → API key (needs billing on; normal use stays in the free monthly allowance).
GOOGLE_MAPS_API_KEY=
# TomTom: developer.tomtom.com → sign up (free, no card) → copy the key from the dashboard.
TOMTOM_API_KEY=
