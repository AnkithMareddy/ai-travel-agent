# Reel Studio settings. Copy to .env (setup-mac.sh does this) and fill in.

# Claude plans the stories, captions and handles "make it shorter" requests.
# Same key as the trip bot's (console.anthropic.com). Without it a rule-based editor is used.
ANTHROPIC_API_KEY=
STUDIO_MODEL=claude-opus-5-5

# Where footage, shots and edits live, and the folder to drop new footage into.
STUDIO_DATA="$HOME/Trip Footage/Studio"
STUDIO_INBOX="$HOME/Trip Footage/Inbox"

# Set a password if you open the studio to your phone (./reel serve --host 0.0.0.0).
STUDIO_PASSWORD=

# Optional: ping the group chat when a day's edits are ready (the trip bot's token + chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_URL=

# Speech-to-text model: tiny, base, small (default), medium, large-v3. Bigger = slower, more accurate.
WHISPER_MODEL=small

# Keep the original camera files after they're cut into shots (uses a lot of disk).
KEEP_ORIGINALS=0
